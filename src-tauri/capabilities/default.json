{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "allow": [
    "window.setTitle",
    "fs.readFile",
    "fs.writeFile"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-home-read-recursive"
  ]
}
