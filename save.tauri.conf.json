{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri State",
  "version": "0.1.0",
  "identifier": "com.tauri.dev0",
  "build": {
    "frontendDist": [
      "../index.html"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TauriState",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "capabilities/main-user-files-write.json",
        "capabilities/shell-capability.json",
        "capabilities/fs-scope-capability.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "./icons/32x32.png",
      "./icons/128x128.png",
      "./icons/128x128@2x.png",
      "./icons/icon.icns",
      "./icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    }
  }
}