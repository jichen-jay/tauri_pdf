{
    "identifier": "fs-scope-capability",
    "description": "Allows the `main` window scoped access to files in the application directory.",
    "windows": [
        "main"
    ],
    "permissions": [
        {
            "identifier": "fs:scope",
            "scope": {
                "allow": [
                    {
                        "path": "$AppDir/.*"
                    },
                    {
                        "path": "$HOME/**"
                    }
                ]
            }
        },
        {
            "identifier": "fs:allow-read-text-file",
            "scope": {
                "allow": [
                    {
                        "path": "$AppDir/.*"
                    },
                    {
                        "path": "$HOME/**"
                    }
                ]
            }
        }
    ]
}